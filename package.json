{
  "name": "flopwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply flop-board --local",
    "migrate:remote": "wrangler d1 migrations apply flop-board --remote",
    "seed": "tsx scripts/seed.ts",
    "agent": "tsx scripts/agent-cli.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/sr25519": "2.4.0",
    "bs58": "6.0.0",
    "canonicalize": "5.1.0",
    "hono": "4.13.19",
    "jose": "6.2.18"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.0",
    "@cloudflare/workers-types": "5.20261121.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.166.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.2": true,
    "sharp@0.35.5": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261119.1": true
  }
}
